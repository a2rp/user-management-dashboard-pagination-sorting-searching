@baseUrl = http://localhost:1198/api/v1
@adminEmail = you@example.com
@adminPassword = replace-with-your-local-admin-password
@userEmail = person@example.com

### Health check
GET {{baseUrl}}/a2rp

### Sign in (the REST client keeps the HTTP-only cookie for later requests)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Current session
GET {{baseUrl}}/session

### List users (any signed-in role)
GET {{baseUrl}}/user-all

### Read one user (any signed-in role)
POST {{baseUrl}}/user
Content-Type: application/json

{
  "email": "{{userEmail}}"
}

### Add a user (administrator only)
POST {{baseUrl}}/user-add
Content-Type: application/json

{
  "name": "Example User",
  "email": "person@example.com",
  "password": "replace-with-a-unique-12-character-password",
  "password_confirm": "replace-with-a-unique-12-character-password",
  "role": "viewer"
}

### Update a user (administrator or editor; editors can change names only)
PATCH {{baseUrl}}/user-update
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "name": "Updated User",
  "role": "viewer"
}

### Delete a user (administrator only)
DELETE {{baseUrl}}/user-delete/{{userEmail}}

### Sign out
POST {{baseUrl}}/logout
